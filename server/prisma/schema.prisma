generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  ADMIN
  USER
}

enum TeamRole {
  MANAGER
  MEMBER
  VIEWER
}

enum WorkItemType {
  CUSTOMER_ISSUE
  ENGINEERING_PROBLEM
  PAYMENT_INVESTIGATION
  PRODUCTION_INCIDENT
  COMPLIANCE_REQUEST
  OPERATIONAL_TASK
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  AWAITING_APPROVAL
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ActivityType {
  CREATED
  UPDATED
  PRIORITY_CHANGED
  STATUS_CHANGED
  ASSIGNED
  TEAM_CHANGED
  COMMENT_ADDED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  RESOLVED
  REOPENED
  CLOSED
}

enum NotificationType {
  ASSIGNED
  REASSIGNED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  CRITICAL_BLOCKED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  passwordHash  String
  platformRole  PlatformRole @default(USER)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships         TeamMembership[]
  createdItems        WorkItem[]       @relation("CreatedItems")
  assignedItems       WorkItem[]       @relation("AssignedItems")
  comments            Comment[]
  activities          ActivityEvent[]
  approvalsRequested  Approval[]       @relation("ApprovalsRequested")
  approvalsDecided    Approval[]       @relation("ApprovalsDecided")
  notifications       Notification[]
  sessions            Session[]
  idempotencyKeys     IdempotencyKey[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships TeamMembership[]
  workItems   WorkItem[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      TeamRole
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Counter {
  name  String @id
  value Int
}

model WorkItem {
  id          String         @id @default(cuid())
  reference   String         @unique
  title       String
  description String
  type        WorkItemType
  status      WorkItemStatus @default(OPEN)
  priority    Priority       @default(MEDIUM)
  // Sortable mirror of `priority` (LOW=1 … CRITICAL=4). Enums are stored as text, so this
  // lets the database order by priority correctly across pages.
  priorityRank Int           @default(2)
  creatorId   String
  assigneeId  String?
  teamId      String
  dueAt       DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  creator       User           @relation("CreatedItems", fields: [creatorId], references: [id], onDelete: Restrict)
  assignee      User?          @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Restrict)
  comments      Comment[]
  activities    ActivityEvent[]
  approvals     Approval[]
  notifications Notification[]

  @@index([status])
  @@index([priority])
  @@index([teamId])
  @@index([assigneeId])
  @@index([updatedAt])
  @@index([dueAt])
  @@index([type])
  @@index([createdAt])
  @@index([status, priority])
  @@index([priorityRank, updatedAt])
  @@index([teamId, status])
}

model Comment {
  id         String   @id @default(cuid())
  workItemId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
}

model ActivityEvent {
  id            String       @id @default(cuid())
  workItemId    String
  actorId       String
  type          ActivityType
  field         String?
  previousValue String?
  newValue      String?
  summary       String
  correlationId String?
  createdAt     DateTime     @default(now())
  workItem      WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor         User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workItemId, createdAt])
  @@index([createdAt])
}

model Approval {
  id               String         @id @default(cuid())
  workItemId       String
  requestedById    String
  decidedById      String?
  status           ApprovalStatus @default(PENDING)
  requestComment   String?
  decisionComment  String?
  requestedAt      DateTime       @default(now())
  decidedAt        DateTime?
  // Unique while pending: set to workItemId for PENDING, null after decision.
  pendingKey       String?        @unique
  workItem         WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  requestedBy      User           @relation("ApprovalsRequested", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy        User?          @relation("ApprovalsDecided", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([workItemId])
  @@index([status])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  workItemId String?
  type       NotificationType
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem   WorkItem?        @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  userId     String
  key        String
  method     String
  path       String
  statusCode Int
  response   String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([createdAt])
}
