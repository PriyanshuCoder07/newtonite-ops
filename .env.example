# Copy to server/.env:   cp .env.example server/.env

# The application currently targets SQLite (path is relative to server/prisma/).
# NOTE: the Prisma schema hard-codes `provider = "sqlite"`. Pointing DATABASE_URL at PostgreSQL
# does NOT work without changing the provider and regenerating migrations (not done or tested).
DATABASE_URL="file:./dev.db"

PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Cookie session
# Replace with a long random value outside local development.
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=newtonite_session
SESSION_TTL_HOURS=12

# Dashboard: items with no update for this many hours are considered stale
STALE_AFTER_HOURS=72
